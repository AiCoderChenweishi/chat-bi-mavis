[Unit]
Description=Data Analyst Agent (FastAPI + DuckDB + 4 LLM agents)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/data-analyst-agent
# DEEPSEEK_API_KEY 实际值不放这里,从 /opt/data-analyst-agent/.env 读
# 部署时执行: cp .env.example .env && vim .env 填入真实 key
EnvironmentFile=/opt/data-analyst-agent/.env
ExecStart=/usr/bin/python3 -u server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
